# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# --- API ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production

# PostgreSQL (leave empty to use embedded PGlite for local demo)
DATABASE_URL=postgres://pulsetriage:pulsetriage@localhost:5432/pulsetriage

# Redis (leave empty to use in-memory queue for local demo)
REDIS_URL=redis://localhost:6379

# OpenAI (leave empty to use the built-in clinical rules engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Payments: auto | stripe | razorpay | mock
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
